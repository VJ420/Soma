# 05_parallel_agent_swarm.sm
# Worker cells. spawn is the concurrent form; this sample calls the workers directly.

worker_task(chunk_id, batch_size):
    print("Agent Worker Cell [" + str(chunk_id) + "] initialized.")
    sum = 0
    i = 0
    while i < batch_size:
        sum = sum + (i * 2)
        i = i + 1
    print("Agent Worker Cell [" + str(chunk_id) + "] finished computation: " + str(sum))
    sum

print("=== Starting Soma swarm cells ===")
worker_task(1, 1000)
worker_task(2, 1000)
worker_task(3, 1000)
print("=== Swarm Workload Completed Successfully ===")
