# 01_hello_cells.fc
# Welcome to Fractal - Infinite Depth from a Single Rule.
# "Built in India for Elite Developers"

# 1. Variables are 0-arg cells
msg: "Namaste, World from Fractal!"
print(msg)

# 2. Universal Cells: Functions without 'def', 'func', or 'fn'
greet(name):
    "Swagatam, {name}! Built for raw speed and zero boilerplate."

# 3. Pipelines: Left-to-right functional composition
"Vishu" -> greet -> print

# 4. Math & Recursion
factorial(n):
    if n <= 1: 1
    else: n * factorial(n - 1)

print("Factorial of 6 is: {factorial(6)}")
