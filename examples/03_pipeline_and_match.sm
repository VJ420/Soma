# 03_pipeline_and_match.fc
# Pipeline data transforms with `->` and pattern matching with guards

classify_http(status):
    match status:
        200: "OK: Resource Fetched"
        201: "CREATED: Resource Created"
        400: "BAD_REQUEST: Client Input Invalid"
        404: "NOT_FOUND: Route Missing"
        err when err >= 500: "SERVER_ERROR: Internal Failure ({err})"
        _: "UNKNOWN_STATUS"

print(classify_http(200))
print(classify_http(404))
print(classify_http(503))

# Left-to-right processing pipeline
square(x): x * x
add_one(x): x + 1

res = 5 -> square -> add_one
print("5 -> square -> add_one = " + str(res))
