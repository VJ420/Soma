# 02_oop_without_boilerplate.sm
# An object is a cell. Its parameters are the fields. There is no self.
# No `class`, no `__init__`, no `this`, and NO `self`!

BankAccount(owner, balance):
    deposit(amount):
        balance = balance + amount
        print("Deposited " + str(amount) + ". New Balance: " + str(balance))
        
    withdraw(amount):
        if amount > balance:
            print("Declined: Insufficient funds in account of " + owner)
        else:
            balance = balance - amount
            print("Withdrew " + str(amount) + ". Remaining: " + str(balance))
            
    summary():
        print("Account: " + owner + " | Balance: " + str(balance))

# Instantiate stateful cell
acc: BankAccount("Aditi Sharma", 50000)

acc.summary()
acc.deposit(25000)
acc.withdraw(12000)
acc.withdraw(100000)
acc.summary()
