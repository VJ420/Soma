# 04_mandelbrot_extreme.fc
# Mandelbrot Set Calculation: Pure computational intensity
# Run with: python fractal_cli.py jit examples/04_mandelbrot_extreme.fc

compute_mandelbrot(w, h, max_iter):
    total = 0
    y = 0
    while y < h:
        cy = (y / h) * 2.0 - 1.0
        x = 0
        while x < w:
            cx = (x / w) * 3.0 - 2.0
            zx = 0.0
            zy = 0.0
            it = 0
            while (zx * zx + zy * zy <= 4.0) and (it < max_iter):
                tmp = zx * zx - zy * zy + cx
                zy = 2.0 * zx * zy + cy
                zx = tmp
                it = it + 1
            total = total + it
            x = x + 1
        y = y + 1
    total

print("Computing 400x400 Mandelbrot Set...")
iterations: compute_mandelbrot(400, 400, 50)
print("Escape iterations total: " + str(iterations))
print("Mandelbrot computation complete.")
