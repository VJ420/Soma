# Rendered by run_benchmarks.py. Every workload returns a deterministic checksum.

queens_safe(columns, row, column):
  prior_row = 0
  is_safe = true
  while (prior_row < row) and is_safe:
    prior_column = columns[prior_row]
    delta = prior_column - column
    if delta < 0:
      delta = 0 - delta
    if (prior_column == column) or (delta == row - prior_row):
      is_safe = false
    prior_row = prior_row + 1
  is_safe

queens_search(columns, row, board_size):
  if row == board_size:
    1
  else:
    solution_count = 0
    candidate_column = 0
    while candidate_column < board_size:
      if queens_safe(columns, row, candidate_column):
        columns[row] = candidate_column
        solution_count = solution_count + queens_search(columns, row + 1, board_size)
      candidate_column = candidate_column + 1
    solution_count

run_nqueens(board_size):
  columns = range(board_size)
  index = 0
  while index < board_size:
    columns[index] = 0
    index = index + 1
  queens_search(columns, 0, board_size)

run_mandelbrot(grid_size):
  escape_total = 0
  y_index = 0
  while y_index < grid_size:
    cy = (y_index / grid_size) * 2.0 - 1.0
    x_index = 0
    while x_index < grid_size:
      cx = (x_index / grid_size) * 3.0 - 2.0
      zx = 0.0
      zy = 0.0
      escape_iteration = 0
      while ((zx * zx + zy * zy) <= 4.0) and (escape_iteration < 40):
        next_x = zx * zx - zy * zy + cx
        zy = 2.0 * zx * zy + cy
        zx = next_x
        escape_iteration = escape_iteration + 1
      escape_total = escape_total + escape_iteration
      x_index = x_index + 1
    y_index = y_index + 1
  escape_total

run_matmul(matrix_size):
  matrix_checksum = 0
  matrix_i = 0
  while matrix_i < matrix_size:
    matrix_j = 0
    while matrix_j < matrix_size:
      matrix_cell = 0
      matrix_k = 0
      while matrix_k < matrix_size:
        matrix_cell = matrix_cell + ((matrix_i * 3 + matrix_k * 7) % 97) * ((matrix_k * 5 + matrix_j * 11) % 89)
        matrix_k = matrix_k + 1
      matrix_checksum = matrix_checksum + matrix_cell
      matrix_j = matrix_j + 1
    matrix_i = matrix_i + 1
  matrix_checksum

run_lcs(sequence_size):
  previous_row = range(sequence_size + 1)
  current_row = range(sequence_size + 1)
  clear_index = 0
  while clear_index <= sequence_size:
    previous_row[clear_index] = 0
    current_row[clear_index] = 0
    clear_index = clear_index + 1
  sequence_i = 1
  while sequence_i <= sequence_size:
    left_value = (sequence_i * 3) % 26
    current_row[0] = 0
    sequence_j = 1
    while sequence_j <= sequence_size:
      if left_value == (sequence_j * 5) % 26:
        current_row[sequence_j] = previous_row[sequence_j - 1] + 1
      else:
        previous_value = previous_row[sequence_j]
        current_value = current_row[sequence_j - 1]
        if previous_value > current_value:
          current_row[sequence_j] = previous_value
        else:
          current_row[sequence_j] = current_value
      sequence_j = sequence_j + 1
    swap_row = previous_row
    previous_row = current_row
    current_row = swap_row
    sequence_i = sequence_i + 1
  previous_row[sequence_size]

run_sieve(limit):
  flags = range(limit + 1)
  flag_index = 0
  while flag_index <= limit:
    flags[flag_index] = true
    flag_index = flag_index + 1
  flags[0] = false
  flags[1] = false
  factor = 2
  while factor * factor <= limit:
    if flags[factor]:
      composite = factor * factor
      while composite <= limit:
        flags[composite] = false
        composite = composite + factor
    factor = factor + 1
  prime_count = 0
  count_index = 0
  while count_index <= limit:
    if flags[count_index]:
      prime_count = prime_count + 1
    count_index = count_index + 1
  prime_count

run_nbody(body_count):
  x_positions = range(body_count)
  y_positions = range(body_count)
  x_velocities = range(body_count)
  y_velocities = range(body_count)
  body_index = 0
  while body_index < body_count:
    x_positions[body_index] = body_index * 1.0
    y_positions[body_index] = body_index * 2.0 + 1.0
    x_velocities[body_index] = 0.0
    y_velocities[body_index] = 0.0
    body_index = body_index + 1
  step_index = 0
  while step_index < 10:
    force_i = 0
    while force_i < body_count:
      force_x = 0.0
      force_y = 0.0
      force_j = 0
      while force_j < body_count:
        if force_i != force_j:
          delta_x = x_positions[force_j] - x_positions[force_i]
          delta_y = y_positions[force_j] - y_positions[force_i]
          distance_squared = delta_x * delta_x + delta_y * delta_y + 0.01
          inverse_distance = 1.0 / sqrt(distance_squared * distance_squared * distance_squared)
          force_x = force_x + delta_x * inverse_distance
          force_y = force_y + delta_y * inverse_distance
        force_j = force_j + 1
      x_velocities[force_i] = x_velocities[force_i] + force_x * 0.01
      y_velocities[force_i] = y_velocities[force_i] + force_y * 0.01
      force_i = force_i + 1
    move_index = 0
    while move_index < body_count:
      x_positions[move_index] = x_positions[move_index] + x_velocities[move_index] * 0.01
      y_positions[move_index] = y_positions[move_index] + y_velocities[move_index] * 0.01
      move_index = move_index + 1
    step_index = step_index + 1
  body_checksum = 0.0
  checksum_index = 0
  while checksum_index < body_count:
    body_checksum = body_checksum + x_positions[checksum_index] + y_positions[checksum_index]
    checksum_index = checksum_index + 1
  body_checksum

TreeNode(left, right):
  check():
    if left == none:
      1
    else:
      1 + left.check() + right.check()

build_tree(depth):
  if depth <= 0:
    TreeNode(none, none)
  else:
    TreeNode(build_tree(depth - 1), build_tree(depth - 1))

run_binarytrees(depth):
  root = build_tree(depth)
  root.check()

run_bfs(node_count):
  dist = range(node_count)
  queue = range(node_count)
  index = 0
  while index < node_count:
    dist[index] = 0 - 1
    queue[index] = 0
    index = index + 1
  dist[0] = 0
  queue[0] = 0
  head = 0
  tail = 1
  while head < tail:
    node = queue[head]
    head = head + 1
    first = (node + 1) % node_count
    second = (node * 3 + 1) % node_count
    if dist[first] < 0:
      dist[first] = dist[node] + 1
      queue[tail] = first
      tail = tail + 1
    if (first != second) and (dist[second] < 0):
      dist[second] = dist[node] + 1
      queue[tail] = second
      tail = tail + 1
  checksum = 0
  index = 0
  while index < node_count:
    if dist[index] >= 0:
      checksum = checksum + dist[index]
    index = index + 1
  checksum

run_sort(count):
  values = range(count)
  state = 1
  fill = 0
  while fill < count:
    state = (state * 48271) % 2147483647
    values[fill] = state
    fill = fill + 1
  aux = range(count)
  width = 1
  while width < count:
    start = 0
    while start < count:
      left = start
      mid = start + width
      if mid > count:
        mid = count
      right = start + width + width
      if right > count:
        right = count
      left_index = left
      right_index = mid
      write_index = left
      while (left_index < mid) and (right_index < right):
        if values[left_index] <= values[right_index]:
          aux[write_index] = values[left_index]
          left_index = left_index + 1
        else:
          aux[write_index] = values[right_index]
          right_index = right_index + 1
        write_index = write_index + 1
      while left_index < mid:
        aux[write_index] = values[left_index]
        left_index = left_index + 1
        write_index = write_index + 1
      while right_index < right:
        aux[write_index] = values[right_index]
        right_index = right_index + 1
        write_index = write_index + 1
      copy_index = left
      while copy_index < right:
        values[copy_index] = aux[copy_index]
        copy_index = copy_index + 1
      start = start + width + width
    width = width + width
  checksum = 0
  index = 0
  while index < count:
    checksum = (checksum + values[index] * (index + 1)) % 1000000007
    index = index + 1
  checksum

run_stencil(grid):
  cell_count = grid * grid
  current = range(cell_count)
  nxt = range(cell_count)
  index = 0
  while index < cell_count:
    current[index] = 0.0
    nxt[index] = 0.0
    index = index + 1
  diagonal = 0
  while diagonal < grid:
    current[diagonal * grid + diagonal] = 1.0
    diagonal = diagonal + 1
  step = 0
  while step < 12:
    y = 0
    while y < grid:
      x = 0
      while x < grid:
        center = current[y * grid + x]
        left = center
        if x > 0:
          left = current[y * grid + (x - 1)]
        right = center
        if x + 1 < grid:
          right = current[y * grid + (x + 1)]
        up = center
        if y > 0:
          up = current[(y - 1) * grid + x]
        down = center
        if y + 1 < grid:
          down = current[(y + 1) * grid + x]
        nxt[y * grid + x] = (center + left + right + up + down) / 5.0
        x = x + 1
      y = y + 1
    swap = current
    current = nxt
    nxt = swap
    step = step + 1
  checksum = 0.0
  index = 0
  while index < cell_count:
    checksum = checksum + current[index] * (index + 1)
    index = index + 1
  checksum

run_histogram(sample_count):
  bins = range(1024)
  clear = 0
  while clear < 1024:
    bins[clear] = 0
    clear = clear + 1
  state = 1
  sample = 0
  while sample < sample_count:
    state = (state * 48271) % 2147483647
    slot = state % 1024
    bins[slot] = bins[slot] + 1
    sample = sample + 1
  checksum = 0
  index = 0
  while index < 1024:
    checksum = checksum + (index + 1) * bins[index]
    index = index + 1
  checksum

run_dijkstra(node_count):
  dist = range(node_count)
  used = range(node_count)
  index = 0
  while index < node_count:
    dist[index] = 1000000000
    used[index] = 0
    index = index + 1
  dist[0] = 0
  step = 0
  while step < node_count:
    selected = 0
    best = 1000000000
    found = 0
    index = 0
    while index < node_count:
      if (used[index] == 0) and (dist[index] < best):
        best = dist[index]
        selected = index
        found = 1
      index = index + 1
    if found == 1:
      used[selected] = 1
      vertex = 0
      while vertex < node_count:
        if (used[vertex] == 0) and (selected != vertex):
          weight = (selected * 17 + vertex * 13) % 97 + 1
          candidate = dist[selected] + weight
          if candidate < dist[vertex]:
            dist[vertex] = candidate
        vertex = vertex + 1
    step = step + 1
  checksum = 0
  index = 0
  while index < node_count:
    checksum = (checksum + dist[index] * (index + 1)) % 1000000007
    index = index + 1
  checksum

run_floyd(node_count):
  cells = node_count * node_count
  dist = range(cells)
  row = 0
  while row < node_count:
    column = 0
    while column < node_count:
      if row == column:
        dist[row * node_count + column] = 0
      else:
        dist[row * node_count + column] = (row * 17 + column * 13) % 97 + 1
      column = column + 1
    row = row + 1
  via = 0
  while via < node_count:
    row = 0
    while row < node_count:
      via_cost = dist[row * node_count + via]
      column = 0
      while column < node_count:
        candidate = via_cost + dist[via * node_count + column]
        index = row * node_count + column
        if candidate < dist[index]:
          dist[index] = candidate
        column = column + 1
      row = row + 1
    via = via + 1
  checksum = 0
  index = 0
  while index < cells:
    checksum = (checksum + dist[index] * (index + 1)) % 1000000007
    index = index + 1
  checksum

run_knapsack(item_count):
  best = range(item_count + 1)
  clear = 0
  while clear <= item_count:
    best[clear] = 0
    clear = clear + 1
  item = 1
  while item <= item_count:
    weight = (item % 17) + 1
    value = (item * 3) % 23 + 1
    slot = item_count
    while slot >= weight:
      candidate = best[slot - weight] + value
      if candidate > best[slot]:
        best[slot] = candidate
      slot = slot - 1
    item = item + 1
  checksum = 0
  index = 0
  while index <= item_count:
    checksum = (checksum + best[index] * (index + 1)) % 1000000007
    index = index + 1
  checksum

run_editdist(length):
  previous = range(length + 1)
  current = range(length + 1)
  index = 0
  while index <= length:
    previous[index] = index
    current[index] = 0
    index = index + 1
  row = 1
  while row <= length:
    current[0] = row
    left_symbol = (row * 3) % 26
    column = 1
    while column <= length:
      cost = 1
      if left_symbol == (column * 5) % 26:
        cost = 0
      choice = previous[column] + 1
      insert = current[column - 1] + 1
      replace = previous[column - 1] + cost
      if insert < choice:
        choice = insert
      if replace < choice:
        choice = replace
      current[column] = choice
      column = column + 1
    swap_row = previous
    previous = current
    current = swap_row
    row = row + 1
  checksum = 0
  index = 0
  while index <= length:
    checksum = (checksum + previous[index] * (index + 1)) % 1000000007
    index = index + 1
  checksum

run_lis(count):
  tails = range(count)
  length = 0
  state = 1
  sample = 0
  while sample < count:
    state = (state * 48271) % 2147483647
    value = state % 1000003
    low = 0
    high = length
    while low < high:
      mid = int((low + high) / 2)
      if tails[mid] < value:
        low = mid + 1
      else:
        high = mid
    if low == length:
      tails[length] = value
      length = length + 1
    else:
      tails[low] = value
    sample = sample + 1
  checksum = 0
  index = 0
  while index < length:
    checksum = (checksum + tails[index] * (index + 1)) % 1000000007
    index = index + 1
  checksum

run_life(grid):
  cells = grid * grid
  current = range(cells)
  nxt = range(cells)
  index = 0
  while index < cells:
    current[index] = 0
    nxt[index] = 0
    index = index + 1
  index = 0
  while index < grid:
    current[index * grid + index] = 1
    current[index * grid + ((index * 3) % grid)] = 1
    index = index + 1
  step = 0
  while step < 12:
    y = 0
    while y < grid:
      x = 0
      while x < grid:
        neighbors = 0
        if (y > 0) and (x > 0) and (current[(y - 1) * grid + (x - 1)] == 1):
          neighbors = neighbors + 1
        if (y > 0) and (current[(y - 1) * grid + x] == 1):
          neighbors = neighbors + 1
        if (y > 0) and (x + 1 < grid) and (current[(y - 1) * grid + (x + 1)] == 1):
          neighbors = neighbors + 1
        if (x > 0) and (current[y * grid + (x - 1)] == 1):
          neighbors = neighbors + 1
        if (x + 1 < grid) and (current[y * grid + (x + 1)] == 1):
          neighbors = neighbors + 1
        if (y + 1 < grid) and (x > 0) and (current[(y + 1) * grid + (x - 1)] == 1):
          neighbors = neighbors + 1
        if (y + 1 < grid) and (current[(y + 1) * grid + x] == 1):
          neighbors = neighbors + 1
        if (y + 1 < grid) and (x + 1 < grid) and (current[(y + 1) * grid + (x + 1)] == 1):
          neighbors = neighbors + 1
        alive = current[y * grid + x]
        born = 0
        if (alive == 1) and ((neighbors == 2) or (neighbors == 3)):
          born = 1
        if (alive == 0) and (neighbors == 3):
          born = 1
        nxt[y * grid + x] = born
        x = x + 1
      y = y + 1
    swap_grid = current
    current = nxt
    nxt = swap_grid
    step = step + 1
  checksum = 0
  index = 0
  while index < cells:
    checksum = checksum + current[index] * (index + 1)
    index = index + 1
  checksum

workload: "{{WORKLOAD}}"
size: {{SIZE}}
iterations: {{ITERATIONS}}
total = 0.0
iteration_index = 0
started_at: perf()
while iteration_index < iterations:
  if workload == "nqueens":
    total = total + run_nqueens(size)
  if workload == "mandelbrot":
    total = total + run_mandelbrot(size)
  if workload == "matmul":
    total = total + run_matmul(size)
  if workload == "lcs":
    total = total + run_lcs(size)
  if workload == "sieve":
    total = total + run_sieve(size)
  if workload == "nbody":
    total = total + run_nbody(size)
  if workload == "binarytrees":
    total = total + run_binarytrees(size)
  if workload == "bfs":
    total = total + run_bfs(size)
  if workload == "sort":
    total = total + run_sort(size)
  if workload == "stencil":
    total = total + run_stencil(size)
  if workload == "histogram":
    total = total + run_histogram(size)
  if workload == "dijkstra":
    total = total + run_dijkstra(size)
  if workload == "floyd":
    total = total + run_floyd(size)
  if workload == "knapsack":
    total = total + run_knapsack(size)
  if workload == "editdist":
    total = total + run_editdist(size)
  if workload == "lis":
    total = total + run_lis(size)
  if workload == "life":
    total = total + run_life(size)
  iteration_index = iteration_index + 1
elapsed_ms = (perf() - started_at) * 1000.0
print("CHECKSUM:" + str(total))
print("ELAPSED_MS:" + str(elapsed_ms))
