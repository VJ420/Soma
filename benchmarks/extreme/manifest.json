{
  "schema_version": 1,
  "profile": "quick",
  "warmups": 1,
  "repetitions": 3,
  "timeout_seconds": 90,
  "workloads": {
    "nqueens": {
      "domain": "Combinatorial search",
      "sizes": [7, 8, 9],
      "expected_time": "O(n!)",
      "expected_space": "O(n)",
      "soma_vm": true
    },
    "mandelbrot": {
      "domain": "Complex dynamics",
      "sizes": [40, 70, 100],
      "expected_time": "O(n^2 * max_iter)",
      "expected_space": "O(1)",
      "soma_vm": true
    },
    "matmul": {
      "domain": "Integer linear algebra",
      "sizes": [16, 24, 32],
      "expected_time": "O(n^3)",
      "expected_space": "O(1)",
      "soma_vm": true
    },
    "lcs": {
      "domain": "Dynamic programming",
      "sizes": [80, 160, 240],
      "expected_time": "O(n^2)",
      "expected_space": "O(n)",
      "soma_vm": true
    },
    "sieve": {
      "domain": "Number theory",
      "sizes": [2000, 6000, 12000],
      "expected_time": "O(n log log n)",
      "expected_space": "O(n)",
      "soma_vm": true
    },
    "nbody": {
      "domain": "Astrophysical simulation",
      "sizes": [12, 20, 28],
      "expected_time": "O(n^2)",
      "expected_space": "O(n)",
      "soma_vm": true
    },
    "binarytrees": {
      "domain": "Allocation and recursion",
      "sizes": [7, 9, 11],
      "expected_time": "O(2^n)",
      "expected_space": "O(2^n)",
      "soma_vm": true
    }
  }
}
