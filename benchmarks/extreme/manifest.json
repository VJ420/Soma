{
  "schema_version": 1,
  "profile": "deep",
  "warmups": 1,
  "repetitions": 3,
  "timeout_seconds": 180,
  "workloads": {
    "nqueens": {
      "domain": "Combinatorial search",
      "sizes": [8, 9, 10],
      "expected_time": "O(n!)",
      "expected_space": "O(n)",
      "soma_vm": true
    },
    "mandelbrot": {
      "domain": "Complex dynamics",
      "sizes": [80, 140, 200],
      "expected_time": "O(n^2 * max_iter)",
      "expected_space": "O(1)",
      "soma_vm": true
    },
    "matmul": {
      "domain": "Integer linear algebra",
      "sizes": [32, 48, 64],
      "expected_time": "O(n^3)",
      "expected_space": "O(1)",
      "soma_vm": true
    },
    "lcs": {
      "domain": "Dynamic programming",
      "sizes": [200, 400, 600],
      "expected_time": "O(n^2)",
      "expected_space": "O(n)",
      "soma_vm": true
    },
    "sieve": {
      "domain": "Number theory",
      "sizes": [50000, 200000, 500000],
      "expected_time": "O(n log log n)",
      "expected_space": "O(n)",
      "soma_vm": true
    },
    "nbody": {
      "domain": "Astrophysical simulation",
      "sizes": [32, 64, 96],
      "expected_time": "O(n^2)",
      "expected_space": "O(n)",
      "soma_vm": true
    },
    "binarytrees": {
      "domain": "Allocation and recursion",
      "sizes": [10, 13, 15],
      "expected_time": "O(2^n)",
      "expected_space": "O(2^n)",
      "soma_vm": true
    }
  }
}
