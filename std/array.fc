# Fractal Standard Array/List Utilities (std/array.fc)

sum(lst):
  total = 0
  for item in lst:
    total = total + item
  total

contains(lst, target):
  found = false
  for item in lst:
    if item == target:
      found = true
  found

max_of(lst):
  if len(lst) == 0: none
  else:
    best = lst[0]
    for item in lst:
      if item > best:
        best = item
    best

average(lst):
  if len(lst) == 0: none
  else: sum(lst) / len(lst)

min(lst): min_of(lst)
max(lst): max_of(lst)

reverse(lst):
  out = []
  i = len(lst) - 1
  while i >= 0:
    push(out, lst[i])
    i = i - 1
  out

min_of(lst):
  if len(lst) == 0: none
  else:
    best = lst[0]
    for item in lst:
      if item < best:
        best = item
    best
