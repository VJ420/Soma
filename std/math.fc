# Fractal Standard Math Module (std/math.fc)

pi: 3.141592653589793
e: 2.718281828459045
tau: pi * 2

clamp(val, min_val, max_val):
  if val < min_val: min_val
  else:
    if val > max_val: max_val
    else: val

lerp(start, stop, t):
  start + (stop - start) * t

gcd(a, b):
  while b != 0:
    t: b
    b = a % b
    a = t
  a

is_prime(n):
  if n <= 1: false
  else:
    if n <= 3: true
    else:
      d = 2
      prime = true
      while d * d <= n:
        if n % d == 0:
          prime = false
        d = d + 1
      prime
